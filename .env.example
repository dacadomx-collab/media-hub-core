# =====================================================================
# MEDIA HUB — Plantilla publica de variables de entorno (.env.example)
# Copiar a ".env" y rellenar con valores reales. ".env" NUNCA se sube
# a Git (ver .gitignore) ni se despliega fuera del servidor.
# =====================================================================

# --- Identidad / entorno ---
APP_NAME="Media HUB"
APP_ENV=local
APP_URL=http://localhost/MediaHUB

# --- Base de datos (config/Database.php - PDO Singleton) ---
DB_HOST=localhost
DB_NAME=tecnidepot_mediahub_db
DB_USER=tu_usuario_db
DB_PASS=tu_password_db
DB_CHARSET=utf8mb4

# --- Seguridad ---
# Semilla para tokens HMAC (recuperacion de contrasena, etc.)
CSRF_SECRET=cambia_esto_por_una_cadena_aleatoria_larga
# Duracion de sesion en segundos (ej. 28800 = 8 horas)
SESSION_LIFETIME=28800
# Token secreto para activar el puente forense de diagnostico en
# config/Database.php / api/login.php (ver CLAUDE.md). Dejar vacio
# desactiva el puente de depuracion en produccion.
MH_DEBUG_TOKEN=

# --- Correo transaccional (api/mailer.php) ---
MAIL_FROM_NAME="Media HUB Audiovisual Studio"
MAIL_FROM_ADDRESS=no-reply@mediahubbcs.com

# Bandeja que recibe los mensajes del modulo Soporte (api/support.php,
# Fase 5.9). Si se deja vacio, cae de vuelta a MAIL_FROM_ADDRESS.
SUPPORT_EMAIL=
